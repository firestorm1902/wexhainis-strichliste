{
  "id": "./",
  "name": "WexStrichliste",
  "short_name": "WexStrichliste",
  "description": "WexStrichliste – die Getränke-Strichliste der 1. Wexhainer Narrenzunft: Getränke per Barcode buchen, auch offline.",
  "lang": "de",
